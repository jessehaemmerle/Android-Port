+static DEVICE_ATTR(type, S_IRUGO, show_current_type, NULL);
+static DEVICE_ATTR(CC_state, S_IRUGO, show_CC_state, NULL);
+static DEVICE_ATTR(mode, S_IWUSR, NULL, config_mode);
