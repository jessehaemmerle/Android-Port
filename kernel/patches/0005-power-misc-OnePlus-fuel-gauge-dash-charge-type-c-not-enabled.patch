+				pr_info("lcd_off_delt_soc:%d,soc=%d,soc_pre=%d\n",
+						bq27541_di->lcd_off_delt_soc, soc,
+						bq27541_di->soc_pre);
+			}
+			get_current_time(&bq27541_di->lcd_off_time);
+			bq27541_di->lcd_is_off=true;
+		} else {
+			bq27541_di->lcd_is_off=false;
+			bq27541_di->lcd_off_delt_soc=0;
+		}
+	}
+	return 0;
