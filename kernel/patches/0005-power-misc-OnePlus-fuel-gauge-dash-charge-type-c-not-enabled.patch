+
+	if (!psy) {
+		psy = power_supply_get_by_name("battery");
+		if (!psy) {
+			pr_err("failed to get ps battery\n");
+			return -EINVAL;
+		}
+	}
+	if (psy->set_property(psy, prop,&value))
+		return -EINVAL;
+
+	return 0;
+}
