+			  const u8 *data)
+{
+	/* Use small WaitResult retry count */
+	return tfa98xx_dsp_set_param_var_wait(tfa98xx, module_id, param_id,
+					      len, data,
+					      TFA98XX_WAITRESULT_NTRIES);
+}
