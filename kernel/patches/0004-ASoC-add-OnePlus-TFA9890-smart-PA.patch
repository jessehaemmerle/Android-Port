+int tfa98xx_dsp_reset_count(struct tfa98xx *tfa98xx)
+{
+	int count;
+
+	tfa98xx_dsp_read_mem(tfa98xx, TFA98XX_XMEM_COUNT_BOOT, 1, &count);
+
+	return count;
+}
