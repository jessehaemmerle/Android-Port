+int tfaContWriteRegsDev(struct tfa98xx *tfa98xx);
+void tfaContShowHeader(struct tfa98xx *tfa98xx, struct nxpTfaHeader *hdr);
+int tfaContWritePatch(struct tfa98xx *tfa98xx);
