+
+	memset(delta_baseline, 0, sizeof(delta_baseline));
+	ret = synaptics_rmi4_i2c_write_byte(tc_g->client, 0xff, 0x1);
+	ret = synaptics_rmi4_i2c_read_block(tc_g->client, 0xE9, 4, &(buf[0x0]));
