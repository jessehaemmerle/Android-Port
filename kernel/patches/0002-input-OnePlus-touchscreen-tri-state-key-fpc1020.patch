+static void delay_qt_ms(unsigned long  w_ms)
+{
+	unsigned long i;
+	unsigned long j;
+	for(i = 0; i < w_ms; i++) {
+		for (j = 0; j < 1000; j++) {
+			udelay(1);
+		}
+	}
+}
