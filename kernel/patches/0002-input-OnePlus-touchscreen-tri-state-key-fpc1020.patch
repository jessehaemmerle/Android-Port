+	mutex_lock(&ts->mutex);
+	synaptics_ts_work_func(ts);
+	mutex_unlock(&ts->mutex);
+	hrtimer_start(&ts->timer, ktime_set(0, 12500000), HRTIMER_MODE_REL);
+	return HRTIMER_NORESTART;
+}
