+    if (button_key == 0x03){
+        is_in_cover = true;
+        ts->key_back = false;
+        ts->key_app_select = false;
+        ret = hrtimer_cancel(&ts->timer);
+        TPD_DEBUG("timer cancel ret[%s]\n",ret?"active":"no active");  
+    }
