<?xml version="1.0" encoding="UTF-8"?>
<!--
  Local manifest fuer den OnePlus 3 (oneplus3, msm8996) auf lineage-23.0
  (= AOSP android-16.0.0_r1). Nach .repo/local_manifests/ kopieren (macht scripts/sync.sh).

  Der Device-Tree (device/oneplus/oneplus3, device/oneplus/common,
  device/oppo/common) liegt in DIESEM Repo unter device/ und wird von
  scripts/sync.sh per rsync in den Quellbaum kopiert.
-->
<manifest>
  <!-- Das Remote "github" kommt aus dem LineageOS-Manifest (fetch=".." = https://github.com/); eine zweite
       Definition mit anderen Attributen laesst "repo sync" mit "remote github already exists" abbrechen. -->
  <remote name="gitlab" fetch="https://gitlab.com/" />

  <!-- Kernel: gepflegter Lineage-4.4.302-Kernel fuer msm8996 (Xiaomi-Zweig lineage-22.2).
       Der OnePlus-3-Kernel selbst endet bei 3.18 (lineage-18.1), das reicht fuer Android 16 nicht.
       Die OnePlus-3-Treiber und -DTS kommen als Patch-Serie aus kernel/patches/ (scripts/sync.sh). -->
  <project name="LineageOS/android_kernel_xiaomi_msm8996" path="kernel/oneplus/msm8996"
           remote="github" revision="lineage-22.2" clone-depth="1" />

  <!-- msm8996-CAF-HALs. lineage-23.0 hat diese drei Projekte UND die zugehoerigen Linkfiles in
       snippets/lineage.xml auskommentiert (msm8996 wird dort nicht mehr gebaut), also muessen sie hier
       wieder rein. Die Linkfiles (hardware/qcom-caf/msm8996/Android.bp und Android.mk) legt scripts/sync.sh an.
       Zweige (geprueft): display/media haben lineage-23.0-caf-msm8996, Audio endet bei 22.2. -->
  <project name="LineageOS/android_hardware_qcom_audio" path="hardware/qcom-caf/msm8996/audio"
           remote="github" revision="lineage-22.2-caf-msm8996" clone-depth="1" />
  <project name="LineageOS/android_hardware_qcom_display" path="hardware/qcom-caf/msm8996/display"
           remote="github" revision="lineage-23.0-caf-msm8996" clone-depth="1" />
  <project name="LineageOS/android_hardware_qcom_media" path="hardware/qcom-caf/msm8996/media"
           remote="github" revision="lineage-23.0-caf-msm8996" clone-depth="1" />

  <!-- Proprietaere Blobs: nur bis lineage-19.1 vorhanden. Besser selbst aus dem
       eigenen Geraet ziehen: device/oneplus/oneplus3/extract-files.sh -->
  <project name="TheMuppets/proprietary_vendor_oneplus" path="vendor/oneplus"
           remote="github" revision="lineage-19.1" clone-depth="1" />

  <!-- Minimale Google-Apps (MindTheGapps, Android-16-Zweig "baklava"):
       Play Store, Play-Dienste-Rahmen, Setup Wizard, Google-App. -->
  <project name="MindTheGapps/vendor_gapps" path="vendor/gapps"
           remote="gitlab" revision="baklava" clone-depth="1" />
</manifest>
