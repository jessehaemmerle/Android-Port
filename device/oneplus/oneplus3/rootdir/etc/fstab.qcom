# Android fstab file.
# The filesystem that contains the filesystem checker binary (typically /system) cannot
# specify MF_CHECK, and must come before any filesystems that do specify MF_CHECK
#TODO: Add 'check' as fs_mgr_flags with data partition.
# Currently we dont have e2fsck compiled. So fs check would failed.
#<src>                                  <mnt_point>              <type>  <mnt_flags and options>                     <fs_mgr_flags>

# Android fstab file.
# <src>                                     <mnt_point>  <type>  <mnt_flags and options>  <fs_mgr_flags>
# Wichtig: system und vendor werden in der ersten Init-Stufe gemountet (first_stage_mount).
# Dafuer braucht der Kernel androidboot.boot_devices=soc/624000.ufshc (siehe BoardConfig.mk).
# Die Vendor-Partition gibt es auf dem OnePlus 3 ab Werk nicht, sie wird mit
# tools/repartition/op3-add-vendor-partition.sh angelegt (docs/REPARTITION.md).

/dev/block/by-name/system               /system                 ext4    ro,barrier=1                                        wait,first_stage_mount
/dev/block/by-name/vendor               /vendor                 ext4    ro,barrier=1                                        wait,first_stage_mount

# Datenpartition: dateibasierte Verschluesselung (FBE) mit ICE wie im msm8996-Referenztree.
# Die alte Ganzgeraete-Verschluesselung (encryptable=footer) wird nicht mehr verwendet.
/dev/block/bootdevice/by-name/userdata  /data                   ext4    noatime,nosuid,nodev,barrier=1,noauto_da_alloc      latemount,wait,check,fileencryption=ice,quota
/dev/block/bootdevice/by-name/misc      /misc                   emmc    defaults                                            defaults
/dev/block/bootdevice/by-name/cache     /cache                  f2fs    noatime,nosuid,nodev,inline_xattr,flush_merge,data_flush  wait
/dev/block/bootdevice/by-name/cache     /cache                  ext4    noatime,nosuid,nodev,barrier=1                      wait
/dev/block/bootdevice/by-name/dsp       /vendor/dsp             ext4    ro,nosuid,nodev,barrier=1                           wait
/dev/block/bootdevice/by-name/modem     /vendor/firmware_mnt    vfat    ro,shortname=lower,uid=1000,gid=1000,dmask=227,fmask=337,context=u:object_r:firmware_file:s0  wait
/dev/block/bootdevice/by-name/bluetooth /vendor/bt_firmware     vfat    ro,shortname=lower,uid=1002,gid=3002,dmask=227,fmask=337,context=u:object_r:bt_firmware_file:s0  wait
/dev/block/bootdevice/by-name/persist   /mnt/vendor/persist     ext4    noatime,nosuid,nodev,barrier=1                      wait
/devices/soc/6a00000.ssusb/6a00000.dwc3/xhci-hcd.0.auto/usb*  auto  auto  defaults                                    voldmanaged=usbotg:auto
